# Fields' API — variáveis de ambiente. Copie para .env (já ignorado pelo git) e preencha.
# Em dev: npm run dev (usa --env-file=.env). No Railway: Variables do serviço.
# Sem as quatro obrigatórias o servidor nem sobe, e diz quais faltam (só os nomes).

# [obrigatória] URL do Postgres. No Railway vem da referência ao serviço do banco.
DATABASE_URL=

# [opcional] "false" desliga o SSL (Postgres local sem TLS). Vazio = SSL sem verificar
# certificado, que é o que o Postgres do Railway exige hoje.
DATABASE_SSL=

# [opcional] Porta HTTP. O Railway injeta a dele; o padrão local é 3001 (o proxy do Vite aponta aqui).
PORT=3001

# [obrigatória] Hash scrypt da senha de login, no formato scrypt$<N>$<r>$<p>$<sal>$<hash>.
# Gere com: node scripts/hash-senha.mjs   (o valor tem "$": em shell, aspas simples)
FIELDS_SENHA_HASH=

# [obrigatória] Segredo HMAC do cookie de sessão, >= 32 caracteres. Trocar derruba todas as sessões.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIELDS_SEGREDO_SESSAO=

# [obrigatória] Token Bearer do MCP, >= 32 caracteres. O MESMO valor vai no env do servidor MCP
# (fields/mcp). Também é a porta de recuperação se o login travar. Gere como o segredo acima.
FIELDS_API_TOKEN=

# ─── Agente (A2b) ───────────────────────────────────────────────────────────────────────────
# Sem AGENTE_HABILITADO o servidor sobe igual, e POST /api/agente/chat responde 503
# AGENTE_DESLIGADO (a tela oferece "Salvar como nota"). Flags aceitam true/1/sim/on.

# [opcional] Liga o motor do agente (a Home e, na A3, o WhatsApp).
AGENTE_HABILITADO=

# [obrigatória com AGENTE_HABILITADO] Chave da API da Anthropic, só deste serviço. Nunca vai a
# log nem a mensagem de erro. Não é exigida com AGENTE_MODELO_FALSO.
ANTHROPIC_API_KEY=

# [opcional, só dev] 1 = modelo de roteiro no lugar da API, sem chave: "/op NomeDaOperacao {json}"
# chama a operação e responde curto; qualquer outro texto volta como "eco: <texto>". RECUSADO
# com NODE_ENV=production (o servidor não sobe).
AGENTE_MODELO_FALSO=

# [opcional] Modelo do agente. Trocar de modelo abre sessão nova na conversa seguinte.
AGENTE_MODELO=claude-opus-5-5

# [opcional] Esforço por canal (low, medium, high, xhigh, max), fixo dentro da sessão.
AGENTE_EFFORT_WEB=medium
AGENTE_EFFORT_WHATSAPP=low

# [opcional] Prazo de um turno, em segundos, contado da chegada da mensagem. A tela consulta o
# turno a cada segundo; o POST da Les Chats espera até 120 s. No máximo 240: turno com mais de
# 5 min é dado como órfão (FALHOU/REINICIO), e acima disso a varredura fecharia um turno vivo.
# Com WHATSAPP_HABILITADO, o do WhatsApp vai no máximo a 110: acima disso o POST da Les Chats
# corta antes da resposta (ela retenta, vira ticket, e o turno escreve sem o Carlos ver).
AGENTE_ORCAMENTO_WEB_S=60
AGENTE_ORCAMENTO_WHATSAPP_S=100

# [opcional] Teto de chamadas ao modelo por turno. Estourou → resposta parcial, status ESGOTADO.
AGENTE_MAX_CHAMADAS=6

# [opcional] Horas sem conversa depois das quais a próxima mensagem abre sessão nova (com um
# resumo dos últimos turnos no lugar do histórico).
SESSAO_OCIOSA_HORAS=6

# [opcional] true = só as operações de LEITURA ficam ligadas — no prompt, nas ferramentas do
# Claude, no catálogo do MCP e no executor. O rollout seguro: um dia só lendo, depois escrevendo.
# Lida no boot (no Railway, mudar a variável reinicia o serviço).
AGENTE_SOMENTE_LEITURA=

# [opcional] Minutos em que o "desfazer" ainda vale depois de uma escrita do agente. Padrão 60.
DESFAZER_JANELA_MIN=60

# ─── WhatsApp pela Les Chats (A3) ───────────────────────────────────────────────────────────
# O webhook POST /api/agente/whatsapp, que a Les Chats chama (Bot kind=EXTERNAL, external_url).
# Com WHATSAPP_HABILITADO, LESCHATS_SEGREDO e FIELDS_DONO_WA_ID passam a ser obrigatórias.
# Sem ele: com LESCHATS_SEGREDO preenchido, a mensagem assinada recebe {handoff: NO_BOT} e vira
# ticket NA HORA no painel da Les Chats (ao religar, feche o ticket para o bot voltar a atender);
# sem o segredo, 503 — e aí a Les Chats só conta a falha: a conversa vira ticket depois da
# TERCEIRA mensagem falhada (contrato §6.1), e até lá as mensagens ficam sem resposta e sem ticket.

# [opcional] Liga o webhook do WhatsApp. O agente (AGENTE_HABILITADO) é quem responde; com ele
# desligado, o webhook devolve um texto fixo avisando.
WHATSAPP_HABILITADO=

# [obrigatória com WHATSAPP_HABILITADO] Segredo HMAC compartilhado com a Les Chats (Bot.external_secret
# lá), >= 32 caracteres, sem espaço nem quebra de linha. Gerado UMA vez e colado nos dois lados:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Nunca vai a log, a resposta de erro nem a query string.
LESCHATS_SEGREDO=

# [obrigatória com WHATSAPP_HABILITADO] O wa_id do Carlos, só dígitos, com DDI e DDD. É a
# allowlist: mensagem de qualquer outro número recebe silêncio ({}), sem ticket.
# COPIE EXATAMENTE como a Les Chats mostra no contato (campo wa_id), não da agenda do celular: a
# Meta manda o wa_id de muitos celulares brasileiros SEM o nono dígito (551199998888 em vez de
# 5511999998888). As duas grafias valem como o mesmo número, mas o log da recusa
# (LESCHATS_REMETENTE_RECUSADO) não traz o número — só quantos dígitos tem cada lado.
FIELDS_DONO_WA_ID=

# [opcional] Template aprovado na WABA para responder quando a janela de 24 h está fechada (texto
# livre fora dela não é entregue). Vazio = a mensagem vira ticket (handoff OUTSIDE_WINDOW). No número
# de teste da Meta, só existe o hello_world.
LESCHATS_TEMPLATE_JANELA_FECHADA=
